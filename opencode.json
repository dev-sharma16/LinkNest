{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      "git remote*": "allow",
      "git add *": "allow",
      "git commit*": "allow",
      "git checkout -b*": "allow",
      "git switch -c*": "allow",
      "git push*": "deny",
      "git pull*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git cherry-pick*": "deny",
      "git reset*": "deny",
      "git revert*": "deny",
      "git checkout main*": "deny",
      "git switch main*": "deny"
    }
  }
}

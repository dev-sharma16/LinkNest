generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Better Auth core schema
// ============================================================

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  accounts           Account[]
  folders            Folder[]
  links              Link[]
  tags               Tag[]
  favorites          Favorite[]
  customDomains      CustomDomain[]
  utmTemplates       UTMTemplate[]
  profile            Profile?
  socialLinks        SocialLink[]
  bioBlocks          BioBlock[]
  bioEvents          BioEvent[]
  leads              Lead[]
  storefronts        Storefront[]
  savedTemplates     SavedTemplate[]
  socialAccounts     SocialAccount[]
  commentAutomations CommentAutomation[]
  aiGenerations      AIGeneration[]

  @@unique([email])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ============================================================
// LinkNest domain schema (Phase 1)
// ============================================================

model Folder {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     Link[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("folders")
}

model Link {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String
  destination String
  title       String?
  description String?
  notes       String?
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId    String? @db.Uuid
  folder      Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  isArchived   Boolean   @default(false)
  passwordHash String?
  expiresAt    DateTime?
  activateAt   DateTime?
  active       Boolean   @default(true)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  iosDeepLink     String?
  androidDeepLink String?

  customDomainId String?       @db.Uuid
  customDomain   CustomDomain? @relation(fields: [customDomainId], references: [id], onDelete: SetNull)

  clicks    Click[]
  tags      LinkTag[]
  favorites Favorite[]
  qrCode    QRCode?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([slug])
  @@index([userId])
  @@index([folderId])
  @@index([createdAt])
  @@index([active])
  @@map("links")
}

model Click {
  id        String   @id @default(uuid()) @db.Uuid
  linkId    String   @db.Uuid
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ipHash    String?
  country   String?
  city      String?
  browser   String?
  os        String?
  device    String?
  referrer  String?
  language  String?
  createdAt DateTime @default(now())

  @@index([linkId])
  @@index([createdAt])
  @@index([country])
  @@index([device])
  @@map("clicks")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     LinkTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model LinkTag {
  linkId String @db.Uuid
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  tagId  String @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([linkId, tagId])
  @@index([tagId])
  @@map("link_tags")
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkId    String   @db.Uuid
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([linkId, userId])
  @@index([userId])
  @@map("favorites")
}

model CustomDomain {
  id        String   @id @default(uuid()) @db.Uuid
  domain    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified  Boolean  @default(false)
  links     Link[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domain])
  @@index([userId])
  @@map("custom_domains")
}

model QRCode {
  id        String   @id @default(uuid()) @db.Uuid
  linkId    String   @unique @db.Uuid
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  fgColor   String   @default("#000000")
  bgColor   String   @default("#ffffff")
  size      Int      @default(512)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("qr_codes")
}

model UTMTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String?
  medium    String?
  campaign  String?
  term      String?
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("utm_templates")
}

// ============================================================
// LinkNest domain schema (Phase 3 - Link in Bio)
// ============================================================

model Profile {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String  @unique
  displayName    String
  avatar         String?
  bio            String?
  location       String?
  website        String?
  verified       Boolean @default(false)
  visibility     String  @default("public")
  published      Boolean @default(false)
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  appearance     Json?

  socials SocialLink[]
  blocks  BioBlock[]
  events  BioEvent[]
  leads   Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([visibility])
  @@index([published])
  @@index([deletedAt])
  @@map("profiles")
}

model SocialLink {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([profileId, order])
  @@map("social_links")
}

model BioBlock {
  id              String    @id @default(uuid()) @db.Uuid
  profileId       String    @db.Uuid
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type            String
  order           Int       @default(0)
  config          Json?
  hidden          Boolean   @default(false)
  scheduleStartAt DateTime?
  scheduleEndAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  events BioEvent[]
  user   User?      @relation(fields: [userId], references: [id])
  userId String?

  @@index([profileId, order])
  @@index([deletedAt])
  @@map("bio_blocks")
}

model BioEvent {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @db.Uuid
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  blockId   String?   @db.Uuid
  block     BioBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  eventType String
  ipHash    String?
  country   String?
  city      String?
  browser   String?
  os        String?
  device    String?
  referrer  String?
  language  String?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@index([profileId])
  @@index([eventType])
  @@index([createdAt])
  @@map("bio_events")
}

model Lead {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String
  name      String?
  email     String
  message   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([profileId])
  @@index([type])
  @@map("leads")
}

// ============================================================
// Saved templates (user-created themes for bio pages & storefronts)
// ============================================================

model SavedTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  type          String // "bio" | "storefront"
  source        String   @default("manual") // "manual" | "ai"
  compatibility String   @default("both") // "link_in_bio" | "storefront" | "both"
  appearance    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, name, type])
  @@index([userId, type])
  @@index([userId, source])
  @@map("saved_templates")
}

// ============================================================
// LinkNest domain schema (Phase 4 - Storefront)
// ============================================================

model Storefront {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  slug           String  @unique
  description    String?
  coverImage     String?
  bannerImage    String?
  visibility     String  @default("public")
  published      Boolean @default(false)
  archived       Boolean @default(false)
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  appearance     Json?

  products ProductCard[]
  events   StorefrontEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([visibility])
  @@index([published])
  @@index([archived])
  @@index([deletedAt])
  @@map("storefronts")
}

model ProductCard {
  id           String     @id @default(uuid()) @db.Uuid
  storefrontId String     @db.Uuid
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  image        String?
  url          String
  ctaText      String?
  featured     Boolean    @default(false)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  events StorefrontEvent[]

  @@index([storefrontId, order])
  @@index([featured])
  @@index([deletedAt])
  @@map("product_cards")
}

model StorefrontEvent {
  id           String       @id @default(uuid()) @db.Uuid
  storefrontId String       @db.Uuid
  storefront   Storefront   @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  productId    String?      @db.Uuid
  product      ProductCard? @relation(fields: [productId], references: [id], onDelete: SetNull)
  eventType    String
  ipHash       String?
  country      String?
  city         String?
  browser      String?
  os           String?
  device       String?
  referrer     String?
  language     String?
  createdAt    DateTime     @default(now())

  @@index([storefrontId])
  @@index([productId])
  @@index([eventType])
  @@index([createdAt])
  @@map("storefront_events")
}

// ============================================================
// LinkNest domain schema (Phase 5 - Comment Automation)
// ============================================================

model SocialAccount {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String    @default("instagram")
  platformUserId String
  username       String
  displayName    String?
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  scope          String?
  status         String    @default("connected")
  email          String?
  avatar         String?

  automations CommentAutomation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([platform, platformUserId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@map("social_accounts")
}

model CommentAutomation {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccountId String        @db.Uuid
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  name            String
  keywords        Json
  replyMessage    String
  url             String
  cooldownMinutes Int           @default(60)
  status          String        @default("draft")

  processedComments AutomationProcessedComment[]
  events            AutomationEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([socialAccountId])
  @@index([status])
  @@index([deletedAt])
  @@map("comment_automations")
}

model AutomationProcessedComment {
  id           String            @id @default(uuid()) @db.Uuid
  automationId String            @db.Uuid
  automation   CommentAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  commentId    String
  status       String
  replyId      String?
  error        String?
  processedAt  DateTime          @default(now())

  @@unique([automationId, commentId])
  @@index([processedAt])
  @@map("automation_processed_comments")
}

model AutomationEvent {
  id                String            @id @default(uuid()) @db.Uuid
  automationId      String            @db.Uuid
  automation        CommentAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  socialAccountId   String?           @db.Uuid
  eventType         String
  commentId         String?
  mediaId           String?
  commenterUsername String?
  commentText       String?
  replyId           String?
  createdAt         DateTime          @default(now())

  @@index([automationId])
  @@index([socialAccountId])
  @@index([eventType])
  @@index([createdAt])
  @@map("automation_events")
}

// ============================================================
// Phase 6 - AI Builder & Custom Presets
// ============================================================

model AIGeneration {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType       String   // "link_in_bio" | "storefront"
  prompt           String
  useCase          String?
  status           String   @default("pending") // "pending" | "processing" | "completed" | "failed" | "cancelled"
  designSpec       Json?
  referenceMetadata Json?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([userId, targetType])
  @@index([status])
  @@index([createdAt])
  @@map("ai_generations")
}
